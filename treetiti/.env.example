# ============================================
# TREETITI marketing site — environment template
# Copy to .env and fill in your keys. All providers below are FREE tiers.
# Only VITE_* vars are exposed to the browser. Never put secrets in VITE_*.
# ============================================

# --- Infra (browser-safe, VITE_ prefix) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://treetiti.com

# --- Free LLM gateways (server/dev only, NO VITE_ prefix) ---
# Groq — fast inference (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk-your-groq-key-here
# Cohere — trial/free inference
COHERE_API_KEY=your-cohere-key-here
# OpenRouter — free :free models pool
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_FULL_API_KEY=sk-or-v1-your-full-key-here
# Pollinations — keyless-friendly AI gateway
POLLINATIONS_API_KEY=your-pollinations-key-here
# Requesty / OmniRouter / LockLLM / Bazalink — OpenAI-compatible free routers
REQUESTY_API_KEY=your-requesty-key-here
OMNIROUTER_API_KEY=your-omnirouter-key-here
LOCKLLM_API_KEY=your-lockllm-key-here
BAZALINK_API_KEY=your-bazalink-key-here
# Google Gemini — AI Studio free tier
GEMINI_API_KEY=your-gemini-key-here
# DeepSeek / Mistral / Cerebras / SambaNova — free tiers
DEEPSEEK_API_KEY=your-deepseek-key-here
MISTRAL_API_KEY=your-mistral-key-here
CEREBRAS_API_KEY=your-cerebras-key-here
SAMBANOVA_API_KEY=your-sambanova-key-here
# BFL (Black Forest Labs) — image
BFL_API_KEY=your-bfl-key-here
# GitHub Models — free premium pool (GPT-4.1/Claude/DeepSeek) via GitHub PAT
GITHUB_MODELS_API_KEY=your-github-pat-here
# NVIDIA NIM — free NVIDIA-hosted models
NVIDIA_NIM_API_KEY=your-nim-key-here
# Z.ai GLM — free GLM-4-Flash
ZAI_API_KEY=your-zai-key-here
# Cloudflare Workers AI — free 10k neurons/day
CLOUDFLARE_API_KEY=your-cf-key-here
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id-here

# --- Local models & services ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1
COMFYUI_URL=http://localhost:8188
PIPERSERVER_URL=http://localhost:5000
HAYSTACK_SERVER_URL=http://localhost:8000

# --- Dev flags (browser-safe) ---
VITE_ENABLE_DEV_TOOLS=true
VITE_DEBUG_MODE=false
VITE_SHOW_API_DEBUG=false
