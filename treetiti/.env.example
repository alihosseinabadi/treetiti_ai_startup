# ============================================
# TREETITI ENVIRONMENT VARIABLES
# ============================================
# Copy to .env for local development or set these in your hosting platform.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq AI (Server-side only — set as a Supabase edge-function secret, never in frontend .env)
# Set with:  npx supabase secrets set GROQ_API_KEY=gsk_...
# GROQ_API_KEY=gsk_...

# Site URL (used in sitemap, canonical, Open Graph)
VITE_SITE_URL=https://treetiti.com
