# TREEtiti AI Agency OS — root environment template.
# Per-service values live in treetiti-ai-os/backend/.env (see its .env.example).
# Copy this file to .env only if you need repo-level Compose overrides.

# Fail closed: unset APP_ENV = production.
APP_ENV=development

# Postgres (docker-compose default: user treetiti / password treetiti / db treetiti_ai_os)
DATABASE_URL=postgresql+psycopg://treetiti:treetiti@localhost:5432/treetiti_ai_os

# First-run admin setup token (>= 32 chars, generated, never committed):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SETUP_TOKEN=
