{
  "name": "Lead Management",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "treetiti-lead",
        "responseMode": "onReceived"
      },
      "id": "webhook",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  name: $json.body.name || '',\n  email: $json.body.email,\n  company: $json.body.company || '',\n  message: $json.body.message || '',\n  phone: $json.body.phone || ''\n}) }}"
      },
      "id": "save-lead",
      "name": "Save Lead (AI-qualified)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/webhooks/notify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subject\": \"[TREEtiti] New lead — {{ $json.name || 'unknown' }}\",\n  \"title\": \"New lead captured\",\n  \"rows\": [\n    [\"Name\", \"{{ $json.name || 'unknown' }}\"],\n    [\"Email\", \"{{ $json.email }}\"],\n    [\"Company\", \"{{ $json.company }}\"],\n    [\"Score\", \"{{ $json.score }}\"],\n    [\"Package\", \"{{ $json.recommended_package }}\"],\n    [\"Suggested reply\", \"{{ $json.suggested_reply }}\"]\n  ]\n}"
      },
      "id": "email",
      "name": "Notify by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    }
  ],
  "connections": {
    "Lead Webhook": { "main": [[{ "node": "Save Lead (AI-qualified)", "type": "main", "index": 0 }]] },
    "Save Lead (AI-qualified)": { "main": [[{ "node": "Notify by Email", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
