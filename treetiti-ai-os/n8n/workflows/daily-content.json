        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent\": \"content\",\n  \"payload\": {\n    \"opportunity\": {{ JSON.stringify($('Run Market Research').item.json.result) }},\n    \"platform\": \"linkedin\",\n    \"count\": 1,\n    \"approve\": true\n  }\n}"
      },
      "id": "content",
      "name": "Create LinkedIn Content",
      "type": "n8n-nodes-base.httpRequest",
