# TREEtiti AI Marketing OS — environment template
# Copy to .env and fill in values. All LLM keys are FREE tiers, no CC needed.

# --- App ---
APP_NAME=treetiti-ai-os
API_PREFIX=/api/v1
ENVIRONMENT=development

# --- Default brain ---
# opencode = keyless free CLI brain | ollama = local | google | groq | openrouter
LLM_PROVIDER=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_DIR=

# --- Arena / battles (free models) ---
BATTLE_MODE=false
BATTLE_MODEL_A=opencode/deepseek-v4-flash-free
BATTLE_MODEL_B=zai/glm-4.7-flash
BATTLE_JUDGE_MODEL=zai/glm-4.5-flash

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:8b

# --- Database ---
DATABASE_URL=postgresql+psycopg://treetiti:treetiti@localhost:5432/treetiti_ai_os
# Light local testing without Postgres:
# DATABASE_URL=sqlite:///./treetiti_dev.db

# --- Google AI Studio (free tier, up to 3 keys for rotation) ---
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_STUDIO_KEY_2=
GOOGLE_AI_STUDIO_KEY_3=
GOOGLE_AI_STUDIO_MODEL=gemini-3.6-flash
GOOGLE_AI_STUDIO_IMAGE_MODEL=nano-banana-pro-preview

# --- OpenRouter (free :free pool) ---
OPENROUTER_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROXY=

# --- Groq (free tier, fast) ---
GROQ_KEY=
GROQ_MODEL=groq/compound

# --- DeepInfra (free tier) ---
DEEPINFRA_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3

# --- GitHub Models (free premium pool: GPT-4.1, Claude, DeepSeek, Llama) ---
# Key = a GitHub Personal Access Token (github.com → Settings → Developer settings
# → Personal access tokens). Endpoint models.github.ai/inference.
GITHUB_MODELS_KEY=
GITHUB_MODELS_MODEL=gpt-4.1-mini

# --- NVIDIA NIM (free NVIDIA-hosted Llama/Qwen/DeepSeek) ---
# Key from build.nvidia.com (free account, no CC).
NIM_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Z.ai / Zhipu GLM (free GLM-4-Flash text + image/video) ---
# Key from api.z.ai or open.bigmodel.cn (free tier).
ZAI_KEY=
ZAI_MODEL=glm-4-flash

# --- Cloudflare Workers AI (free 10k neurons/day) ---
# Key + Account ID from dash.cloudflare.com → Workers → AI.
CF_KEY=
CF_ACCOUNT_ID=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Agnes (free gateway, chat + image + video) ---
AGNES_KEY=
AGNES_BASE_URL=
AGNES_MODEL=agnes-2.5-pro
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# --- Generic OpenAI-compatible router fallback ---
ROUTER_BASE_URL=
ROUTER_KEY=

# --- Rate limits (requests/day per key) ---
RATE_LIMIT_OPENROUTER_DAILY=50
RATE_LIMIT_GROQ_DAILY=1440
RATE_LIMIT_GITHUB_MODELS_DAILY=1000
RATE_LIMIT_NIM_DAILY=2000
RATE_LIMIT_ZAI_DAILY=4000
RATE_LIMIT_CF_DAILY=10000

# --- Auth ---
ADMIN_EMAIL=admin@treetiti.com
ADMIN_PASSWORD=change-me-in-prod
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_PASSWORDLESS=false
AUTH_PASSWORDLESS_LOGIN=false

# --- n8n ---
N8N_URL=http://localhost:5678

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOSS_IDS=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Social publishing (optional) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Webhook shared secret ---
# When set, POST /leads, /webhooks/publish and /webhooks/notify require the
# X-Webhook-Secret header. Leave empty ONLY for local development.
WEBHOOK_SHARED_SECRET=
