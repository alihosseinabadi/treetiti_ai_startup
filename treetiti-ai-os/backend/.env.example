# TREEtiti AI Marketing OS — environment template
# Copy to .env and fill in values. All LLM keys are FREE tiers, no CC needed.

# --- Database ---
DATABASE_URL=postgresql+psycopg://treetiti:treetiti@localhost:5432/treetiti_ai_os

# --- Provider API keys (free tiers) ---
# Google AI Studio — powers gemini-2.5-flash for most agents.
# Up to 3 keys for rotation (default 1500 req/day each).
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_STUDIO_KEY_2=
GOOGLE_AI_STUDIO_KEY_3=
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash
GOOGLE_AI_STUDIO_IMAGE_MODEL=gemini-2.5-flash-image

# OpenRouter — powers Qwen3 Coder + DeepSeek R1 (50 req/day free).
OPENROUTER_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Groq — optional extra provider.
GROQ_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate limits (requests/day per key) ---
RATE_LIMIT_OPENROUTER_DAILY=50
RATE_LIMIT_GROQ_DAILY=1440

# --- Auth ---
ADMIN_EMAIL=admin@treetiti.com
ADMIN_PASSWORD=change-me-in-prod
JWT_SECRET=change-me-in-prod
AUTH_PASSWORDLESS=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOSS_IDS=

# --- Social publishing (optional) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
CORS_ORIGINS=http://localhost:5173,https://treetiti.com,https://www.treetiti.com
