# TREEtiti AI Marketing OS — environment template
# Copy to .env and fill in values. All LLM keys are FREE tiers, no CC needed.

# --- App ---
APP_NAME=treetiti-ai-os
API_PREFIX=/api/v1
# Fail closed: unset APP_ENV = production (validate_prod refuses to boot
# without real JWT/ADMIN/WEBHOOK secrets). Use development locally only.
APP_ENV=development
ENVIRONMENT=development

# --- Default brain ---
# opencode = keyless free CLI brain | ollama = local | google | groq | openrouter
LLM_PROVIDER=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_DIR=

# --- Arena / battles (free models) ---
BATTLE_MODE=false
BATTLE_MODEL_A=opencode/deepseek-v4-flash-free
BATTLE_MODEL_B=zai/glm-4.7-flash
BATTLE_JUDGE_MODEL=zai/glm-4.5-flash

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:8b

# --- Database ---
DATABASE_URL=postgresql+psycopg://treetiti:treetiti@localhost:5432/treetiti_ai_os
# Light local testing without Postgres:
# DATABASE_URL=sqlite:///./treetiti_dev.db

# --- Google AI Studio (free tier, up to 3 keys for rotation) ---
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_STUDIO_KEY_2=
GOOGLE_AI_STUDIO_KEY_3=
GOOGLE_AI_STUDIO_MODEL=gemini-3.6-flash
GOOGLE_AI_STUDIO_IMAGE_MODEL=nano-banana-pro-preview

# --- OpenRouter (free :free pool) ---
OPENROUTER_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROXY=

# --- Groq (free tier, fast) ---
GROQ_KEY=
GROQ_MODEL=groq/compound

# --- DeepInfra (free tier) ---
DEEPINFRA_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3

# --- GitHub Models (free premium pool: GPT-4.1, Claude, DeepSeek, Llama) ---
# Key = a GitHub Personal Access Token (github.com → Settings → Developer settings
# → Personal access tokens). Endpoint models.github.ai/inference.
GITHUB_MODELS_KEY=
GITHUB_MODELS_MODEL=gpt-4.1-mini

# --- NVIDIA NIM (free NVIDIA-hosted Llama/Qwen/DeepSeek) ---
# Key from build.nvidia.com (free account, no CC).
NIM_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Z.ai / Zhipu GLM (free GLM-4-Flash text + image/video) ---
# Key from api.z.ai or open.bigmodel.cn (free tier).
ZAI_KEY=
ZAI_MODEL=glm-4-flash

# --- Cloudflare Workers AI (free 10k neurons/day) ---
# Key + Account ID from dash.cloudflare.com → Workers → AI.
CF_KEY=
CF_ACCOUNT_ID=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Agnes (free gateway, chat + image + video) ---
AGNES_KEY=
AGNES_BASE_URL=
AGNES_MODEL=agnes-2.5-pro
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# --- Extra LLM providers (shared key pool with treetiti/.env) ---
# Each key accepts both styles, e.g. CEREBRAS_KEY and CEREBRAS_API_KEY.
# GEMINI_API_KEY works as GOOGLE_AI_STUDIO_KEY, GROQ_API_KEY as GROQ_KEY,
# OPENROUTER_API_KEY as OPENROUTER_KEY.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=openai/gpt-4o-mini
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTER_MODEL=auto
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai

# --- Generic OpenAI-compatible router fallback ---
ROUTER_BASE_URL=
ROUTER_KEY=

# --- Rate limits (requests/day per key) ---
RATE_LIMIT_OPENROUTER_DAILY=50
RATE_LIMIT_GROQ_DAILY=1440
RATE_LIMIT_GITHUB_MODELS_DAILY=1000
RATE_LIMIT_NIM_DAILY=2000
RATE_LIMIT_ZAI_DAILY=4000
RATE_LIMIT_CF_DAILY=10000
RATE_LIMIT_CEREBRAS_DAILY=1000
RATE_LIMIT_COHERE_DAILY=1000
RATE_LIMIT_DEEPSEEK_DAILY=1000
RATE_LIMIT_MISTRAL_DAILY=1000
RATE_LIMIT_SAMBANOVA_DAILY=1000
RATE_LIMIT_REQUESTY_DAILY=1000
RATE_LIMIT_OMNIROUTER_DAILY=10000
RATE_LIMIT_POLLINATIONS_DAILY=3000

# --- Auth ---
ADMIN_EMAIL=admin@treetiti.com
ADMIN_PASSWORD=change-me-in-prod
# First-run admin setup token (>= 32 chars, generated, never committed):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SETUP_TOKEN=
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For (rate limit).
# Empty = trust nothing (direct peer IP only).
TRUSTED_PROXIES=

# --- n8n ---
N8N_URL=http://localhost:5678

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOSS_IDS=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Social publishing (optional) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Webhook shared secret ---
# Signs publish/notify webhooks: hex(HMAC-SHA256(secret, timestamp.body)),
# sent as X-Webhook-Timestamp + X-Webhook-Signature (±5 min replay window).
# POST /leads is a public form instead: rate limit + honeypot + origin check.
# REQUIRED in production (fail-closed); leave empty ONLY for local development.
WEBHOOK_SHARED_SECRET=
